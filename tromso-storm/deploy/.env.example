SITE_HOST=tromsostorm.no
SITE_URL=https://tromsostorm.no
LETSENCRYPT_EMAIL=drift@example.no
TRAEFIK_NETWORK=tromsostorm-web
TRAEFIK_CERT_RESOLVER=letsencrypt

WORDPRESS_IMAGE=wordpress:php8.3-apache
WORDPRESS_CLI_IMAGE=wordpress:cli-php8.3
MARIADB_IMAGE=mariadb:11.4
TRAEFIK_IMAGE=traefik:v3.5
NGINX_IMAGE=nginx:1.29-alpine

DB_NAME=wordpress_storm
DB_USER=wordpress

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=35
RCLONE_REMOTE=tromsostorm-backups
RCLONE_PATH=tromsostorm

# Optional. Enables cached Norwegian-to-English GPT translation after visitors select EN.
OPENAI_API_KEY=
STORM_TRANSLATION_MODEL=gpt-5-mini

# Optional until the project-specific NIF client has been approved.
# Keep the secret only in the ignored deployment .env or the production secret store.
NIF_CLIENT_ID=
NIF_CLIENT_SECRET=
NIF_ORG_ID=220005
